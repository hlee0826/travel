# Copy to .env.local and enter the project API key locally. Never paste it into chat.
OPENAI_API_KEY=
MINHWA_IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_REVIEW_MODEL=gpt-5-mini
# Conservative admission budget: each attempt reserves 300 cents for 24 hours.
MINHWA_DAILY_BUDGET_CENTS=30000

# Hosted deployment uses .env.hosted.local; see docs/hosting.md.
# Create it with deploy/configure_hosted.py; never commit or upload that file.
